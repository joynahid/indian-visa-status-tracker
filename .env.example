# Singapore proxy for Indian visa sites (required)
# Format: http://USERNAME:PASSWORD@IP:PORT
COMMA_SEPARATED_PROXY_URLS=http://USER:PASS@IP:PORT

# 2captcha API key (fallback OCR solver)
TWO_CAPTCHA_KEY=your_2captcha_api_key

# Shared PostgreSQL instance
POSTGRES_DB=indianvisa
POSTGRES_USER=indianvisa
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://indianvisa:change_me@postgres:5432/indianvisa

# Frontend build target for local development
BASE_API_URL=http://localhost:8765

# Webshare API token (optional, for proxy health)
# (not currently used by the app)
